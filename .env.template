# =============================================================================
# 微信群智能客服机器人 MVP - 环境变量模板
# 启动前：cp .env.template .env && chmod 600 .env
# 即使 USE_MOCK_LLM=true，所有凭证仍必须存在（但 mock 模式下不断网络）
# =============================================================================

# --- Mode Switches（默认 mock=true 用于开发/测试）---
USE_MOCK_LLM=true
USE_MOCK_LICENSE=true
USAGE_REPORT_ENABLED=false
USAGE_PERIOD=daily
# --- 素材（媒体识别 + AssetSender）---
# MOCK_MEDIA_RECOGNIZE=true 时使用 mock 描述，否则调真实 Qwen-VL
MOCK_MEDIA_RECOGNIZE=true
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_VL_MODEL=qwen-vl-plus
# --- 素材库（图片/文件资产保存目录）---
ASSET_STORAGE_DIR=./data/assets
ASSET_MAX_SIZE_MB=5
ASSET_ALLOWED_TYPES=image,file

# --- WeCom（必填，启动时 zod 校验存在性 + 格式）---
WECHAT_CORP_ID=ww0123456789abcdef
WECHAT_AGENT_ID=1000001
WECHAT_AGENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WECHAT_TOKEN=TokenByCustomerProvided
WECHAT_ENCODING_AES_KEY=43charsKey_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WECHAT_BOT_USER_ID=

# --- FastGPT（必填，mock 模式只校验存在性不断网络）---
FASTGPT_BASE_URL=https://fastgpt.example.com
FASTGPT_API_KEY=fastgpt-xxxxxxxxxxxxxxxx
FASTGPT_DATASET_IDS=

# --- LLM Channels（必填，mock 模式只校验存在性）---
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=sk-xxxxxxxx
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=sk-xxxxxxxx
LLM_TIMEOUT_MS=15000

# --- Admin（必填）---
ADMIN_USER=admin
ADMIN_PASSWORD=please_change_me
ALLOWED_ADMIN_IPS=127.0.0.1/32,10.0.0.0/8

# --- Thresholds（可选，缺省值见 config.schema.ts）---
CONFIDENCE_THRESHOLD=0.75
CONTEXT_ROUNDS=5
CONTEXT_TTL_SEC=600
MISS_RECORD_RETENTION_DAYS=90
SLOW_REPLY_TEXT=系统繁忙，请稍后再试或联系人工客服
REFUSAL_TEXT=暂时没有合适答案，已记录到工单。紧急问题请 @ 客服。

# --- Redis（可选）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Postgres（可选）---
DATABASE_URL=postgresql://cs:cs@127.0.0.1:5432/csbot

# --- License（可选）---
LICENSE_FILE=license/license.lic

# --- Rate Limit（可选）---
RATE_GROUP_PER_MIN=20
RATE_USER_PER_MIN=5

# --- 群聊准入（可选）---
# 群消息必须携带 ChatId（缺失即丢弃并告警，避免误发私聊）
REQUIRE_GROUP_CHAT_ID=true
# 只处理这些群（逗号分隔，空=不限制）
ALLOWED_CHAT_IDS=

# --- Segment（可选）---
MAX_SEGMENT_BYTES=2048
SEGMENT_SAFE_BYTES=2000
SEGMENT_GAP_MS=300

# --- Server（可选）---
PORT=3000
HOST=0.0.0.0

# --- Asset / Mock（可选）---
MOCK_QA_FILE=config/mock-qa.json
KEYWORDS_FILE=config/keywords.yml
SENSITIVE_WORDS_FILE=config/sensitive-words.txt
