# 四阶段构建
# 0. native：编译 Rust N-API 模块（linux/amd64 glibc，与 runtime 同代）
# 1. builder：编译 TS
# 2. assets：汇总 native 产物
# 3. runtime：distroless 镜像

# ----- Stage 0: native -----
# 必须与 runtime 同为 Debian 12 (glibc 2.36)，否则 .node 无法加载。
# 这里不做 cross-compile：stage 本身就是 linux/amd64，产物即目标平台。
FROM rust:1-bookworm AS native
WORKDIR /native

# Rust crate 依赖 napi-derive（纯 Rust），无需 node/openssl；
# 只需链接器与 pkg-config。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY packages/license-native/Cargo.toml packages/license-native/Cargo.lock ./
COPY packages/license-native/build.rs ./
COPY packages/license-native/src/ ./src/

# 依赖层单独缓存：只改 src/ 时不会重编全部依赖
RUN mkdir -p src \
    && printf 'fn main() {}\n' > build.rs \
    && cargo build --release --target x86_64-unknown-linux-gnu \
    && rm -rf src build.rs

# 恢复真实源码并重编（产物覆盖上一层的缓存占位）
COPY packages/license-native/build.rs ./
COPY packages/license-native/src/ ./src/
RUN cargo build --release --target x86_64-unknown-linux-gnu

# cdylib（crate-type=cdylib）→ napi 约定的 index.node
RUN cp target/x86_64-unknown-linux-gnu/release/liblicense_native.so /native/index.node \
    && file /native/index.node \
    && ls -l /native/index.node

# ----- Stage 1: builder -----
FROM node:20-bookworm-slim AS builder
WORKDIR /app

# 启用 pnpm
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

# 复制依赖描述
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/license-native/package.json packages/license-native/
COPY apps/adapter/package.json apps/adapter/

# 安装依赖
RUN pnpm install --frozen-lockfile

# 复制源码
COPY packages/ packages/
COPY apps/adapter/ apps/adapter/
COPY config/ config/
COPY scripts/ scripts/
COPY tsconfig.base.json ./

# 编译
RUN pnpm -C packages/shared build
RUN pnpm -C apps/adapter build

# 运行期可写目录（镜像内默认非 root 也可写；compose 绑定挂载时按 CSBOT_UID 覆盖）
RUN mkdir -p /app/data /app/logs /app/license

# ---- 交付加固（安全基线：JS 全量混淆 + 剔除 sourcemap）----
# 版本固定，构建期通过 npx 获取，避免把混淆器打进运行时镜像。
# 交付镜像的指纹（docker images --no-trunc）随交付文档一并提供用户核对。
RUN npx --yes javascript-obfuscator@4.1.1 apps/adapter/dist \
      --output apps/adapter/dist \
      --compact true \
      --control-flow-flattening true \
      --dead-code-injection true \
      --string-array true \
      --string-array-rotate true \
      --identifier-names-generator hexadecimal \
      --self-defending true \
    && npx --yes javascript-obfuscator@4.1.1 packages/shared/dist \
      --output packages/shared/dist \
      --compact true \
      --control-flow-flattening true \
      --string-array true \
      --string-array-rotate true \
      --identifier-names-generator hexadecimal \
      --self-defending true \
    && find apps/adapter/dist packages/shared/dist node_modules -name '*.map' -delete \
    && find apps/adapter/dist packages/shared/dist -name '*.d.ts' -delete

# ----- Stage 2: assets -----
# 把 native .node 汇齐（pubkey 已编入 .node 内部，无需单独拷）
FROM scratch AS assets
COPY --from=native /native/index.node /assets/packages/license-native/prebuilds/linux-x64-gnu/index.node

# ----- Stage 3: runtime -----
FROM gcr.io/distroless/nodejs20-debian12:nonroot AS runtime
WORKDIR /app

COPY --from=builder /app/apps/adapter/dist/ /app/apps/adapter/dist/
COPY --from=builder /app/apps/adapter/package.json /app/apps/adapter/package.json
COPY --from=builder /app/packages/shared/dist/ /app/packages/shared/dist/
COPY --from=builder /app/packages/shared/package.json /app/packages/shared/package.json
COPY --from=builder /app/packages/license-native/package.json /app/packages/license-native/package.json
COPY --from=builder /app/node_modules/ /app/node_modules/
COPY --from=builder --chown=65532:65532 /app/data /app/data
COPY --from=builder --chown=65532:65532 /app/logs /app/logs
COPY --from=builder --chown=65532:65532 /app/license /app/license
COPY --from=builder /app/apps/adapter/node_modules/ /app/apps/adapter/node_modules/
COPY --from=builder /app/packages/shared/node_modules/ /app/packages/shared/node_modules/
COPY --from=builder /app/packages/license-native/node_modules/ /app/packages/license-native/node_modules/
COPY --from=assets /assets/packages/license-native/prebuilds/ /app/packages/license-native/prebuilds/
COPY --from=builder /app/apps/adapter/src/miss/001-miss-record.sql /app/migrate/001-miss-record.sql
COPY --from=builder /app/apps/adapter/src/media/002-asset.sql /app/migrate/002-asset.sql
COPY --from=builder /app/apps/adapter/src/license/003-licensed-chat.sql /app/migrate/003-licensed-chat.sql
COPY --from=builder /app/apps/adapter/src/import/004-import-job.sql /app/migrate/004-import-job.sql
COPY --from=builder /app/apps/adapter/src/import/005-approved-qa.sql /app/migrate/005-approved-qa.sql
COPY --from=builder /app/apps/adapter/src/import/006-import-job-stored-path.sql /app/migrate/006-import-job-stored-path.sql
COPY --from=builder /app/apps/adapter/src/platform/007-tenant.sql /app/migrate/007-tenant.sql
COPY --from=builder /app/apps/adapter/src/import/007-import-pipeline.sql /app/migrate/008-import-pipeline.sql
COPY --from=builder /app/apps/adapter/src/miss/009-miss-media-status.sql /app/migrate/010-miss-media-status.sql
COPY --from=builder /app/apps/adapter/src/media/010-asset-md5.sql /app/migrate/011-asset-md5.sql
COPY --from=builder /app/apps/adapter/src/platform/011-usage-counters.sql /app/migrate/012-usage-counters.sql
COPY --from=builder /app/apps/adapter/src/platform/012-tenant-ports.sql /app/migrate/013-tenant-ports.sql
COPY --from=builder /app/apps/adapter/src/platform/008-control-plane.sql /app/migrate/009-control-plane.sql
COPY --from=builder /app/config /app/config
COPY --from=builder /app/scripts /app/scripts

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

USER nonroot

CMD ["apps/adapter/dist/main.js"]
