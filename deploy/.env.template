# =============================================================================
# 部署环境变量（docker-compose 用）
# 此文件由 deploy/.env 加载，.env.template 复制后由 docker-compose 自动套用
# =============================================================================

# Postgres
POSTGRES_USER=cs
POSTGRES_PASSWORD=please_change_me
POSTGRES_DB=csbot

# Redis
REDIS_PASSWORD=please_change_me

# FastGPT
FASTGPT_ROOT_PASSWORD=please_change_me
FASTGPT_FILE_TOKEN=filetoken_change_me_32chars

# 业务凭证（参考根 .env.template）
WECHAT_CORP_ID=ww0123456789abcdef
WECHAT_AGENT_ID=1000001
WECHAT_AGENT_SECRET=replace_at_deploy
WECHAT_TOKEN=replace_at_deploy
WECHAT_ENCODING_AES_KEY=43charsKey_replace_at_deploy_replace_at_deploy
WECHAT_BOT_USER_ID=

FASTGPT_BASE_URL=http://fastgpt:3000
FASTGPT_API_KEY=fastgpt-replace-at-deploy
FASTGPT_DATASET_IDS=

LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=sk-replace
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=sk-replace
LLM_TIMEOUT_MS=15000

ADMIN_USER=admin
ADMIN_PASSWORD=please_change_me
ALLOWED_ADMIN_IPS=127.0.0.1/32,10.0.0.0/8
# 仅这些地址转发来的 X-Forwarded-For 会被采信（固定 compose 子网）
TRUSTED_PROXY_CIDRS=172.30.0.0/24
# compose 内部子网；与宿主网络冲突时修改
CSBOT_SUBNET=172.30.0.0/24
# 控制面默认不发布端口；远程访问用 docker-compose.control-plane-expose.yml
# CONTROL_PLANE_BIND=10.0.0.5
PLATFORM_UPGRADE_WINDOW=02:00-04:00
PLATFORM_UPGRADE_NOTICE_DAYS=3
# 容器运行 UID/GID 与宿主 docker 组
CSBOT_UID=65532
CSBOT_GID=65532
DOCKER_GID=999

USE_MOCK_LLM=false
USE_MOCK_LICENSE=false
USAGE_REPORT_ENABLED=false

CONFIDENCE_THRESHOLD=0.75
CONTEXT_ROUNDS=5
CONTEXT_TTL_SEC=600
MISS_RECORD_RETENTION_DAYS=90
SLOW_REPLY_TEXT=系统繁忙，请稍后再试或联系人工客服
REFUSAL_TEXT=暂时没有合适答案，已记录到工单。紧急问题请 @ 客服。

DATABASE_URL=postgresql://cs:please_change_me@pg:5432/csbot
LICENSE_FILE=/app/license/license.lic

RATE_GROUP_PER_MIN=20
RATE_USER_PER_MIN=5
MAX_SEGMENT_BYTES=2048
SEGMENT_SAFE_BYTES=2000
SEGMENT_GAP_MS=300
PORT=3000
HOST=0.0.0.0

MOCK_QA_FILE=/app/config/mock-qa.json
KEYWORDS_FILE=/app/config/keywords.yml
SENSITIVE_WORDS_FILE=/app/config/sensitive-words.txt

# 模型通道（增项 D）：cloud / hybrid / local
MODEL_MODE=cloud
LOCAL_LLM_BASE_URL=http://vllm:8000/v1
LOCAL_EMBEDDING_URL=http://xinference:9997
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 运维/邮件 Webhook（可选）；OPS_WEBHOOK_URL 同时用于 license 与 LLM 双通道失败告警
OPS_WEBHOOK_URL=
LLM_ALERT_THRESHOLD=3
LLM_ALERT_WINDOW_MS=300000
LLM_ALERT_COOLDOWN_MS=1800000
EMAIL_WEBHOOK_URL=

# 图片识别（增项 A，可选）
QWEN_VL_BASE_URL=
QWEN_VL_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus

# 审计异地导出目录与导入姓名词典
PLATFORM_AUDIT_ARCHIVE_DIR=backup/audit
IMPORT_NAMES_FILE=config/import-names.txt
