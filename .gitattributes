# Normalize text to LF in the repo (avoid WSL/Windows CRLF noise).
* text=auto eol=lf

# Explicit text types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.template text eol=lf
*.rs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
Dockerfile* text eol=lf
*.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows scripts may keep CRLF if added later
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.node binary
*.so binary
*.dylib binary
*.dll binary
*.wasm binary
*.lic binary
*.pem binary
*.key binary
