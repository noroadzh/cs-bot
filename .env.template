# =============================================================================
# 微信群智能客服机器人 — 环境变量
# 用法：cp .env.template .env && chmod 600 .env
# 私有化部署时，这个文件放在 /opt/cs-bot/.env
#
# 取值只有三类：
#   自己生成  在服务器执行 openssl rand -hex 24，把输出贴进来。脚本不会打印这些口令。
#   从控制台抄  企微管理后台、DeepSeek、阿里云百炼、FastGPT 应用页面。
#   保持默认  私有化单机不要改，除非后面的注释写了要改。
#
# 生产必须改：USE_MOCK_LLM、USE_MOCK_LICENSE 改成 false。
# 改完 .env 后执行 docker compose -f deploy/docker-compose.yml up -d
# restart 不会重新读取本文件。
# =============================================================================

# --- 运行开关 ---
# 是否用假的大模型回答。生产填 false，才会请求下面的 LLM Key。
# 开发/自测才用 true。来源：自己改。
USE_MOCK_LLM=true
# 是否跳过授权签名校验。生产填 false，并放入交付方签发的 license/license.lic。
# 来源：自己改。
USE_MOCK_LICENSE=true
# 是否把用量上报到 SaaS 控制面。私有化保持 false。SaaS 租户实例才改 true。
# 来源：按部署形态自己改。
USAGE_REPORT_ENABLED=false
# 用量统计周期：daily / weekly / monthly。私有化保持 daily。
# 来源：保持默认。
USAGE_PERIOD=daily

# --- 图片识别（增项 A，不用图片问答就保持默认）---
# true = 不调用视觉模型，用假描述。要识别群里的图片时改 false，并填写下面三个 QWEN_VL_*。
# 来源：自己改。
MOCK_MEDIA_RECOGNIZE=true
# 通义千问视觉接口地址。用阿里云时保持这行。
# 来源：阿里云百炼控制台的兼容 OpenAI 地址，一般不用改。
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 通义 API Key。不用图片识别时，这行占位可以留着。
# 来源：阿里云百炼 / DashScope 控制台 → API-KEY，以 sk- 开头。
QWEN_VL_API_KEY=sk-xxxxxxxxxxxxxxxx
# 视觉模型名。来源：阿里云模型列表，默认 qwen-vl-plus 即可。
QWEN_VL_MODEL=qwen-vl-plus
# 素材文件在容器内的目录。Compose 会把宿主机 data/ 挂进来。来源：保持默认。
ASSET_STORAGE_DIR=./data/assets
# 单个素材大小上限，单位 MB。来源：保持默认，合同有特殊限制再改。
ASSET_MAX_SIZE_MB=5
# 允许入库的素材类型。来源：保持默认。
ASSET_ALLOWED_TYPES=image,file

# --- 企业微信（必填，从企微管理后台抄，不要自己编）---
# 企业 ID。来源：企微管理后台 → 我的企业 → 企业信息 → 企业 ID，以 ww 开头。
WECHAT_CORP_ID=ww0123456789abcdef
# 自建应用的 AgentId，纯数字。来源：应用管理 → 你的自建应用 → AgentId。
WECHAT_AGENT_ID=1000001
# 自建应用 Secret。来源：同一个应用页面的 Secret。至少 8 位。
WECHAT_AGENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 接收消息的 Token。来源：该应用 → 接收消息 → 设置 API 接收 → Token（页面上点随机生成）。
WECHAT_TOKEN=TokenByCustomerProvided
# 接收消息的 EncodingAESKey。来源：同上页面的 EncodingAESKey。必须正好 43 位，多一位少一位都起不来。
WECHAT_ENCODING_AES_KEY=43charsKey_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# 机器人在企微里的成员 UserId。只在要按成员 ID 识别 @ 时填写。不知道就留空。
# 来源：企微通讯录里该成员的账号。
WECHAT_BOT_USER_ID=
# 机器人在群里显示的名字，用来识别「@这个名字」。可留空。
# 来源：你在群里看到的机器人名称。
WECHAT_BOT_NAME=

# --- FastGPT ---
# 镜像地址。国内默认阿里云，不用取消注释。海外机器改成下一行并去掉行首 # ：
# FASTGPT_IMAGE=ghcr.io/labring/fastgpt:v4.8.17
# 来源：保持默认，或按网络环境改成上面的 ghcr 地址。Docker Hub 没有 labring/fastgpt。
#
# 适配层访问 FastGPT 的内网地址。私有化必须是 http://fastgpt:3000，不要填公网域名。
# 来源：Compose 里的服务名，保持 http://fastgpt:3000。
FASTGPT_BASE_URL=https://fastgpt.example.com
# FastGPT 应用的 API Key。第一次安装先填至少 8 位的占位符（例如 fastgpt-pending-key）。
# 系统起来后：浏览器打开 https://<域名>:8443，用 root 和 FASTGPT_ROOT_PASSWORD 登录，
# 建好知识库和应用，在应用里复制 API Key，再写回这里并执行 compose up -d adapter。
# 来源：FastGPT 应用页面，不是本模板，也不是安装脚本。
FASTGPT_API_KEY=fastgpt-xxxxxxxxxxxxxxxx
# 只检索这些知识库。多个用英文逗号分隔。留空表示不在这里限制。
# 来源：FastGPT 知识库设置里的 dataset id。可留空。
FASTGPT_DATASET_IDS=

# --- 大模型（必填。Key 从对应控制台创建，地址一般保持默认）---
# 主模型接口。来源：DeepSeek 开放平台文档，保持 https://api.deepseek.com/v1。
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
# 主模型 Key。来源：https://platform.deepseek.com → API keys，以 sk- 开头。至少 8 位。
LLM_PRIMARY_API_KEY=sk-xxxxxxxx
# 备用模型接口。主模型失败时使用。来源：阿里云百炼兼容地址，保持默认即可。
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 备用模型 Key。来源：阿里云百炼 / DashScope 控制台的 API-KEY。可与 QWEN_VL_API_KEY 相同。
LLM_FALLBACK_API_KEY=sk-xxxxxxxx
# 等待模型的最长时间，毫秒。来源：保持 15000。
LLM_TIMEOUT_MS=15000
# 下面三项是失败告警：窗口内失败几次才告警、窗口长度、两次告警的最短间隔。单位毫秒。
# 只有同时配置了 OPS_WEBHOOK_URL 才会真正推送。来源：保持默认。
LLM_ALERT_THRESHOLD=3
LLM_ALERT_WINDOW_MS=300000
LLM_ALERT_COOLDOWN_MS=1800000

# --- 管理接口（运营台 /admin、/console 的登录）---
# 用户名。来源：自己定，默认 admin。
ADMIN_USER=admin
# 管理接口口令。来源：自己生成，openssl rand -hex 24。至少 12 位。
# install.sh 会拒绝空值、短于 12 位、以及 password / 123456 这类常见口令。
ADMIN_PASSWORD=
# 允许调用管理接口的来源 IP，CIDR，多个用英文逗号。
# 来源：运维电脑的公网 IP，写成 x.x.x.x/32。不要写成 0.0.0.0/0。
ALLOWED_ADMIN_IPS=127.0.0.1/32,10.0.0.0/8
# FastGPT 知识库后台对外端口。来源：保持 8443。安全组只给运维网段放行这个端口。
FASTGPT_ADMIN_PORT=8443
# 允许打开 https://<域名>:8443 的来源网段。留空 = 谁都不能访问。
# 来源：运维公网 IP，例如 203.0.113.20/32。填好后重新执行 sudo ./deploy/install.sh。
FASTGPT_ADMIN_ALLOW_CIDRS=

# --- SaaS 控制面（私有化单机全部保持默认或留空，不要填签发私钥）---
# 上报用量时的 Bearer token。私有化留空。来源：仅 SaaS 由平台分配。
CONTROL_PLANE_TOKEN=
# 控制面监听地址。私有化留空。禁止填 0.0.0.0。来源：仅 SaaS 管理网卡地址。
CONTROL_PLANE_BIND=
# 租户实例访问控制面的地址。私有化保持默认即可，控制面不会启动。
PLATFORM_TENANT_CONTROL_PLANE_URL=http://host.docker.internal:3100
# 租户密钥加密主密钥。私有化留空。来源：仅 SaaS，openssl rand -hex 32。
PLATFORM_MASTER_KEY=
# 租户证书从哪来。私有化保持 file。来源：保持默认。
PLATFORM_TLS_PROVIDER=file
# 授权签发方式。私有化保持 shell，客户包里没有签发工具，这项不会被用到。
LICENSE_ISSUER=shell
# 签发私钥在容器内的路径。客户部署包不含这个文件。私有化不要改、也不要自己放私钥。
LICENSE_ISSUER_KEY=/app/tools/license-issuer/issuer-private.pem
# 授权要绑定的机器指纹。私有化留空，指纹在签发 license.lic 时由交付方采集。
PLATFORM_LICENSE_FINGERPRINT=
# 控制面数据目录。私有化保持默认。
PLATFORM_HOST_DATA_DIR=/opt/cs-bot/data/control
# 宿主上 docker 命令的路径。私有化用不到。来源：which docker，保持默认。
DOCKER_BIN=/usr/bin/docker
# 宿主上 compose 插件路径。私有化用不到。来源：保持默认。
DOCKER_COMPOSE_PLUGIN=/usr/libexec/docker/cli-plugins/docker-compose

# --- 问答行为（一般保持默认，话术可按客户改）---
# 低于这个检索分就拒答。来源：保持 0.75，业务要更严或更松再改。
CONFIDENCE_THRESHOLD=0.75
# 带上最近几轮对话。来源：保持 5。
CONTEXT_ROUNDS=5
# 上下文保留秒数。来源：保持 600（10 分钟）。
CONTEXT_TTL_SEC=600
# 未命中记录保留天数。来源：保持 90。
MISS_RECORD_RETENTION_DAYS=90
# 模型超时或系统忙时发给群里的句子。来源：可改成客户确认过的话术。
SLOW_REPLY_TEXT=系统繁忙，请稍后再试或联系人工客服
# 知识库没有答案时发给群里的句子。来源：可改成客户确认过的话术。
REFUSAL_TEXT=暂时没有合适答案，已记录到工单。紧急问题请 @ 客服。

# --- Redis（私有化口令留空）---
# 下面两项只给本机开发用。Compose 会把容器里的地址改成 redis:6379。来源：保持默认。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 口令。私有化必须留空。当前健康检查不带口令，填了之后 Redis 会起不来。
# 来源：留空。不要执行 openssl 来填这一项。
REDIS_PASSWORD=
# Redis 库号。来源：保持 0。
REDIS_DB=0

# --- 数据库和 FastGPT 口令（自己生成，不是从别的系统查出来的）---
# 在服务器执行 openssl rand -hex 24，运行三次，分别贴到下面三项。三项不要相同。
# PostgreSQL 口令。install.sh 要求至少 12 位。pg 和 FastGPT 连库都用它。
POSTGRES_PASSWORD=
# FastGPT 后台登录口令。用户名固定是 root。打开 https://<域名>:8443 时用这个口令。
# 来源：自己生成。不是 FastGPT 页面上已有的密码。
FASTGPT_ROOT_PASSWORD=
# FastGPT 内部文件令牌，用来签文件访问，不是登录口令，后台哪里都查不到。
# 来源：自己生成。生成后不要再改，改了已有文件链接会失效。
FASTGPT_FILE_TOKEN=

# --- Postgres 连接串 ---
# 本机开发用的默认串。私有化由 Compose 按 POSTGRES_PASSWORD 重写成
# postgresql://cs:<口令>@pg:5432/csbot，不用手改这行。
DATABASE_URL=postgresql://cs:cs@127.0.0.1:5432/csbot

# --- 授权文件位置 ---
# 容器内读取的路径。私有化保持 license/license.lic。
# 文件本身来源：交付方按这台机器签发后，放到 /opt/cs-bot/license/license.lic。自己不能生成。
LICENSE_FILE=license/license.lic

# --- 限流（保持默认）---
# 每个群每分钟最多几条。来源：保持 20。
RATE_GROUP_PER_MIN=20
# 同一个人每分钟最多几条。来源：保持 5。
RATE_USER_PER_MIN=5

# --- 哪些群可以触发机器人 ---
# true = 没有群 ID 的消息直接丢掉，避免私聊误回。来源：保持 true。
REQUIRE_GROUP_CHAT_ID=true
# 只处理这些群。逗号分隔群 chatId。留空 = 授权范围内的群都处理。
# 来源：企微回调日志或会话存档里的 chatId。一般先留空。
ALLOWED_CHAT_IDS=

# --- 长回答拆成多条消息（企微单条长度有限）---
# 单位是字节。来源：三项都保持默认。
MAX_SEGMENT_BYTES=2048
SEGMENT_SAFE_BYTES=2000
SEGMENT_GAP_MS=300

# --- 适配层进程监听（只在容器内部，不要改成对外端口）---
# 来源：保持 3000 和 0.0.0.0。对外只有 Nginx 的 443。
PORT=3000
HOST=0.0.0.0

# --- 包内配置文件路径（保持默认，对应压缩包里的 config/）---
# 假问答样本，只有 USE_MOCK_LLM=true 时才用。来源：保持默认。
MOCK_QA_FILE=config/mock-qa.json
# 触发关键词文件。来源：保持默认。要改词就改 config/keywords.yml，不要改这一行。
KEYWORDS_FILE=config/keywords.yml
# 出站敏感词文件。来源：保持默认。词库在 config/sensitive-words.txt。
SENSITIVE_WORDS_FILE=config/sensitive-words.txt
